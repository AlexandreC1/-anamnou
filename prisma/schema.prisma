generator client {
  provider = "prisma-client"
  output = "../apps/api/src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Operational metadata only. Business entities start in their authorized phases.
model SystemMetadata {
  key       String   @id @db.VarChar(64)
  value     String   @db.VarChar(256)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum PlatformRole {
  USER
  PLATFORM_ADMIN
}

enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(254)
  displayName String @db.VarChar(80)
  passwordHash String
  locale String @default("en") @db.VarChar(2)
  status UserStatus @default(PENDING)
  role PlatformRole @default(USER)
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  // TOTP secrets are AES-256-GCM sealed with MFA_ENCRYPTION_KEY, bound to the user ID.
  mfaSecret String? @db.VarChar(200)
  mfaEnabledAt DateTime? @db.Timestamptz(3)
  mfaLastStep Int?
  mfaPendingSecret String? @db.VarChar(200)
  mfaPendingExpiresAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  sessions Session[]
  mfaRecoveryCodes MfaRecoveryCode[]
  mfaChallenges MfaChallenge[]
  tokens IdentityToken[]
  auditLogs AuditLog[]
  emailJobs IdentityEmailJob[]
  schools SchoolAdmin[]
  memberships ClassMembership[]
  invitations Invitation[]
  mediaAssets MediaAsset[]
}

model Session {
  id String @unique @default(uuid()) @db.Uuid
  tokenHash String @id @db.Char(64)
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  // Set only when this session proved a second factor. Platform privileges require it.
  mfaVerifiedAt DateTime? @db.Timestamptz(3)
  @@index([userId])
  @@index([expiresAt])
}

// One-use codes; only SHA-256 hashes of 80-bit random values are stored.
model MfaRecoveryCode {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String @unique @db.Char(64)
  usedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([userId])
}

// Short-lived proof that the password step succeeded; the token is held in an HttpOnly cookie.
model MfaChallenge {
  tokenHash String @id @db.Char(64)
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts Int @default(0)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([userId])
  @@index([expiresAt])
}

model IdentityToken {
  tokenHash String @id @db.Char(64)
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose TokenPurpose
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([userId, purpose])
  @@index([expiresAt])
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  actorUserId String? @db.Uuid
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action String @db.VarChar(64)
  targetId String @db.Uuid
  metadata Json @default("{}")
  schoolId String? @db.Uuid
  classId String? @db.Uuid
  school School? @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  class Class? @relation(fields: [classId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([actorUserId, createdAt])
  @@index([schoolId, createdAt])
  @@index([classId, createdAt])
}

// Shared across API instances; keys are hashes of normalized account identifiers.
model AuthThrottle {
  key String @id @db.VarChar(100)
  count Int
  expiresAt DateTime @db.Timestamptz(3)
  @@index([expiresAt])
}

// Contains delivery intent only; no plaintext token or password payload.
model IdentityEmailJob {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose TokenPurpose
  attempts Int @default(0)
  leaseId String? @db.Uuid
  failedAt DateTime? @db.Timestamptz(3)
  nextAttemptAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([userId, purpose])
  @@index([nextAttemptAt])
}

enum ClassRole {
  MEMBER
  CLASS_ADMIN
  STAFF
  GUEST
}

enum MembershipStatus {
  ACTIVE
  REMOVED
}

enum InvitationStatus {
  ACTIVE
  REVOKED
}

model School {
  verifiedAt DateTime? @db.Timestamptz(3)
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(120)
  slug String @unique @db.VarChar(80)
  location String? @db.VarChar(120)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  admins SchoolAdmin[]
  classes Class[]
  auditLogs AuditLog[]
}

model SchoolAdmin {
  schoolId String @db.Uuid
  userId String @db.Uuid
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@id([schoolId, userId])
  @@index([userId])
}

model Class {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  name String @db.VarChar(120)
  slug String @db.VarChar(80)
  graduationYear Int
  motto String? @db.VarChar(240)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  memberships ClassMembership[]
  invitations Invitation[]
  auditLogs AuditLog[]
  mediaAssets MediaAsset[]
  yearbook Yearbook?
  @@unique([schoolId, slug])
}

model ClassMembership {
  id String @id @default(uuid()) @db.Uuid
  classId String @db.Uuid
  userId String @db.Uuid
  class Class @relation(fields: [classId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role ClassRole @default(MEMBER)
  status MembershipStatus @default(ACTIVE)
  joinedAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  acceptances InvitationAcceptance[]
  profile Profile?
  @@unique([classId, userId])
  @@unique([id, classId])
  @@index([userId, status])
  @@index([classId, status, role])
}

model Invitation {
  id String @id @default(uuid()) @db.Uuid
  classId String @db.Uuid
  createdById String @db.Uuid
  class Class @relation(fields: [classId], references: [id], onDelete: Restrict)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  tokenHash String @unique @db.Char(64)
  role ClassRole @default(MEMBER)
  status InvitationStatus @default(ACTIVE)
  expiresAt DateTime @db.Timestamptz(3)
  maxUses Int
  usedCount Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  acceptances InvitationAcceptance[]
  @@unique([id, classId])
  @@index([classId, createdAt])
}

model InvitationAcceptance {
  invitationId String @db.Uuid
  membershipId String @db.Uuid
  classId String @db.Uuid
  invitation Invitation @relation(fields: [invitationId, classId], references: [id, classId], onDelete: Restrict)
  membership ClassMembership @relation(fields: [membershipId, classId], references: [id, classId], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@id([invitationId, membershipId])
  @@index([membershipId, classId])
}

enum ProfileVisibility {
  PRIVATE
  CLASS
}

enum MediaPurpose {
  PROFILE
  YEARBOOK
}

enum MediaStatus {
  PENDING
  PROCESSING
  UPLOADED
  READY
  DELETED
}

enum SectionType {
  COVER
  MESSAGE
  CLASS_PHOTO
  MEMBERS
  STAFF
  QUOTES
  GALLERY
  ACKNOWLEDGEMENTS
  GRADUATION
}

model Profile {
  id String @id @default(uuid()) @db.Uuid
  classId String @db.Uuid
  membershipId String @unique @db.Uuid
  membership ClassMembership @relation(fields: [membershipId, classId], references: [id, classId], onDelete: Restrict)
  displayName String @db.VarChar(80)
  nickname String? @db.VarChar(80)
  bio String? @db.VarChar(1000)
  quote String? @db.VarChar(280)
  activities String? @db.VarChar(500)
  aspiration String? @db.VarChar(280)
  contact String? @db.VarChar(300)
  visibility ProfileVisibility @default(PRIVATE)
  contactVisibility ProfileVisibility @default(PRIVATE)
  photoAssetId String? @db.Uuid
  photo MediaAsset? @relation(fields: [photoAssetId, classId], references: [id, classId], onDelete: Restrict)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([classId, visibility])
  @@unique([membershipId, classId])
}

model MediaAsset {
  id String @id @default(uuid()) @db.Uuid
  classId String @db.Uuid
  ownerUserId String @db.Uuid
  class Class @relation(fields: [classId], references: [id], onDelete: Restrict)
  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  purpose MediaPurpose
  status MediaStatus @default(PENDING)
  storageKey String @unique @db.VarChar(200)
  declaredType String @db.VarChar(40)
  declaredSize Int
  purgedAt DateTime? @db.Timestamptz(3)
  size Int?
  width Int?
  height Int?
  alt String @db.VarChar(240)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  profiles Profile[]
  sectionMedia YearbookSectionMedia[]
  @@unique([id, classId])
  @@index([classId, ownerUserId, status])
  @@index([status, expiresAt])
}

model Yearbook {
  id String @id @default(uuid()) @db.Uuid
  classId String @unique @db.Uuid
  class Class @relation(fields: [classId], references: [id], onDelete: Restrict)
  title String @db.VarChar(120)
  theme String @default("PAPER") @db.VarChar(16)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  sections YearbookSection[]
  @@unique([id, classId])
}

model YearbookSection {
  id String @id @default(uuid()) @db.Uuid
  yearbookId String @db.Uuid
  classId String @db.Uuid
  yearbook Yearbook @relation(fields: [yearbookId, classId], references: [id, classId], onDelete: Restrict)
  type SectionType
  title String @db.VarChar(120)
  body String @default("") @db.VarChar(4000)
  position Int
  media YearbookSectionMedia[]
  @@unique([yearbookId, position])
  @@unique([id, classId])
}

model YearbookSectionMedia {
  sectionId String @db.Uuid
  assetId String @db.Uuid
  classId String @db.Uuid
  position Int
  section YearbookSection @relation(fields: [sectionId, classId], references: [id, classId], onDelete: Cascade)
  asset MediaAsset @relation(fields: [assetId, classId], references: [id, classId], onDelete: Restrict)
  @@id([sectionId, assetId])
  @@unique([sectionId, position])
  @@index([assetId, classId])
}
