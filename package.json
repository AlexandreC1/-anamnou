{
  "name": "yearbook-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "storage:init": "tsx scripts/init-storage.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "dev:web": "npm run dev --workspace @yearbook/web",
    "dev:api": "npm run dev --workspace @yearbook/api",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run db:generate && tsc -p tsconfig.tools.json --noEmit && npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:setup": "node scripts/setup-test-db.mjs",
    "test:integration": "npm run test:setup && npm run test:integration --workspace @yearbook/api",
    "test:e2e": "npm run test:setup && playwright test",
    "build": "npm run db:generate && npm run build --workspaces",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run test:integration && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/cli": "0.1.19",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "pg": "8.23.0",
    "prettier": "^3.6.2",
    "prisma": "7.10.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "overrides": {
    "mysql2": "3.24.4",
    "multer": "2.3.0",
    "deepmerge-ts": "8.0.2"
  },
  "scarfSettings": {
    "enabled": false
  }
}
