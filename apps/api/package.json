{
  "name": "@yearbook/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc-watch -p tsconfig.json --onSuccess \"node --env-file=../../.env dist/main.js\"",
    "start": "node --env-file=../../.env dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json \u0026\u0026 node --test dist-test/test/*.test.js",
    "test:integration": "tsc -p tsconfig.test.json \u0026\u0026 node --env-file=../../.env --test dist-test/test/*.integration.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12",
    "express-rate-limit": "^8.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "tsc-watch": "^7.2.0"
  }
}
